{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Write(./.env)",
      "Write(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash|Grep|Glob|NotebookRead|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python .claude/hooks/block_env.py" }
        ]
      }
    ]
  }
}
